{
    "name": "sandermuller/boost-skills",
    "description": "A package that ships AI skills to be used for shipping code in both packages and projects",
    "keywords": [
        "sandermuller",
        "boost-skills",
        "php"
    ],
    "homepage": "https://github.com/sandermuller/boost-skills",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "github@scode.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "sandermuller/boost-core": "^1.3"
    },
    "require-dev": {
        "laravel/pao": "^1.0",
        "nunomaduro/collision": "^8.0",
        "sandermuller/package-boost-php": "^1.0",
        "stolt/skill-validator": "0.0.1"
    },
    "scripts": {
        "post-install-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::run"
        ],
        "post-update-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::run"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
