{
    "name": "sandermuller/boost-skills",
    "description": "A package that ships AI skills to be used for shipping code in both packages and projects",
    "keywords": [
        "sandermuller",
        "boost-skills",
        "php"
    ],
    "homepage": "https://github.com/sandermuller/boost-skills",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "github@scode.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "sandermuller/boost-core": "^1.6"
    },
    "require-dev": {
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.0",
        "sandermuller/package-boost-php": "^1.0",
        "stolt/lean-package-validator": "^6.4",
        "stolt/skill-validator": "0.0.5"
    },
    "scripts": {
        "post-install-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::run"
        ],
        "post-update-cmd": [
            "SanderMuller\\BoostCore\\Scripts\\BoostAutoSync::run"
        ],
        "format": "vendor/bin/pint",
        "validate-gitattributes": "vendor/bin/lean-package-validator validate",
        "qa": [
            "@format",
            "@validate-gitattributes"
        ],
        "qa-check": [
            "vendor/bin/pint --test",
            "@validate-gitattributes"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
